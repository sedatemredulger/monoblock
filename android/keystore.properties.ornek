# Bu dosyayı `keystore.properties` adıyla kopyala ve doldur.
#
# UYARI: keystore.properties ve .keystore dosyası ASLA git'e girmez,
# ASLA kimseyle paylaşılmaz, ASLA bu sohbete yapıştırılmaz.
# Kaybedersen uygulamayı bir daha güncelleyemezsin — Google dahil kimse
# geri veremez. İki ayrı yere yedekle (biri çevrimdışı olsun).
#
# Anahtarı üretmek için (bu uygulamaya ÖZEL yeni bir anahtar üret):
#
#   keytool -genkey -v -keystore monoblock.keystore -alias monoblock \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Windows'ta yol ayıracı olarak ters bölü değil, düz bölü kullan.

storeFile=C:/dukagames/Monoblock/monoblock.keystore
storePassword=BURAYA_MAGAZA_PAROLASI
keyAlias=monoblock
keyPassword=BURAYA_ANAHTAR_PAROLASI
